<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#5F9EA0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Zdjęcie i odcisk palca -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imagePhoto"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:contentDescription="Zdjęcie osoby"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/imageFingerprint"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:contentDescription="Odcisk palca"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <!-- Numer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Numer"
            android:textColor="#FFFFFF" />

        <EditText
            android:id="@+id/editNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F0FFFF"
            android:inputType="number"
            android:padding="8dp"
            android:singleLine="true" />

        <!-- Imię -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Imię"
            android:textColor="#FFFFFF" />

        <EditText
            android:id="@+id/editFirstName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F0FFFF"
            android:inputType="textPersonName"
            android:padding="8dp"
            android:singleLine="true" />

        <!-- Nazwisko -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Nazwisko"
            android:textColor="#FFFFFF" />

        <EditText
            android:id="@+id/editLastName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F0FFFF"
            android:inputType="textPersonName"
            android:padding="8dp"
            android:singleLine="true" />

        <!-- Grupa "Kolor oczu" -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Kolor oczu"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioGroupEyeColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:drawable/editbox_dropdown_light_frame"
            android:backgroundTint="#33FFFFFF"
            android:padding="8dp">

            <RadioButton
                android:id="@+id/radioBlue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="niebieskie"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/radioGreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="zielone"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/radioHazel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="piwne"
                android:textColor="#FFFFFF" />
        </RadioGroup>

        <!-- Przycisk OK -->
        <Button
            android:id="@+id/buttonOk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#F0FFFF"
            android:text="OK"
            android:textColor="#000000" />
    </LinearLayout>
</ScrollView>